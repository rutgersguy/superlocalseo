# ============================================================
# SuperLocalSEO — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://slseo:slseo@postgres:5432/superlocalseo

# Redis
REDIS_URL=redis://redis:6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for storing API keys — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TIER1_PRICE_ID=
STRIPE_TIER2_PRICE_ID=
STRIPE_TIER3_PRICE_ID=
STRIPE_TIER1_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER2_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER3_EXTRA_LOCATION_PRICE_ID=
STRIPE_LITE_BASE_PRICE_ID=     # Stripe price ID for Lite plan ($99/mo recurring, no setup fee)

# Resend
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@superlocalseo.com
RESEND_FROM_NAME=SuperLocalSEO

# BrightLocal (set per client via DB — this is the master account key)
BRIGHTLOCAL_API_KEY=

# EmbedMyReviews
EMBEDMYREVIEWS_API_KEY=
EMBEDMYREVIEWS_WEBHOOK_SECRET=

# PDF Reports
REPORTS_DIR=/app/data/reports

# Monitoring (optional)
SENTRY_DSN=
