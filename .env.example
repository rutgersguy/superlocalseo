# ============================================================
# SuperLocalSEO — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# App
# MUST be `production` on the deployed API. Several security controls key off
# this value and are SKIPPED in development: all rate limiters (auth, general,
# AI), the public audit-form limiter, and the `Secure` flag on the refresh-token
# cookie. Production ran as `development` until 2026-08-16 — see issue #161.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://slseo:slseo@postgres:5432/superlocalseo

# Redis
REDIS_URL=redis://redis:6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for storing API keys — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TIER1_PRICE_ID=
STRIPE_TIER2_PRICE_ID=
STRIPE_TIER3_PRICE_ID=
STRIPE_TIER1_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER2_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER3_EXTRA_LOCATION_PRICE_ID=
STRIPE_LITE_BASE_PRICE_ID=     # Stripe price ID for Lite plan ($99/mo recurring, no setup fee)

# Resend
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@superlocalseo.com
RESEND_FROM_NAME=SuperLocalSEO

# BrightLocal (set per client via DB — this is the master account key)
BRIGHTLOCAL_API_KEY=

# EmbedMyReviews
EMBEDMYREVIEWS_API_KEY=
EMBEDMYREVIEWS_WEBHOOK_SECRET=

# PDF Reports
REPORTS_DIR=/app/data/reports

# Monitoring — NOT optional in production, and currently EMPTY on the live API,
# which means there is no error capture at all. `docker logs` is the only record,
# and Docker discards a container's logs when it is recreated, so every deploy
# destroys the error history.
#
# To enable (~2 minutes, needs a sentry.io account):
#   1. sentry.io -> Projects -> Create Project -> platform "Node.js / Express"
#   2. Copy the DSN it shows (https://<key>@<org>.ingest.sentry.io/<project>)
#   3. Paste below, then: docker compose up -d --force-recreate --no-deps api
#   4. Verify: the API logs "Sentry" on boot and a forced 500 appears in the UI
#
# The wiring is already correct and guarded on this value being set —
# Sentry.init() at app.ts:15 and setupExpressErrorHandler() at app.ts:58, after
# the routes and before errorHandler. Nothing else needs to change.
#
# Caveat: tracesSampleRate is 0.1, but Sentry v8 wants init() to run before the
# other imports for full auto-instrumentation. Error capture works as written;
# performance tracing will be partial until init moves into its own module
# imported first.
SENTRY_DSN=
