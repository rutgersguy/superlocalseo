# ============================================================
# SuperLocalSEO — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# App
# MUST be `production` on the deployed API. Several security controls key off
# this value and are SKIPPED in development: all rate limiters (auth, general,
# AI), the public audit-form limiter, and the `Secure` flag on the refresh-token
# cookie. Production ran as `development` until 2026-08-16 — see issue #161.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://slseo:slseo@postgres:5432/superlocalseo

# Redis
REDIS_URL=redis://redis:6379

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for storing API keys — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TIER1_PRICE_ID=
STRIPE_TIER2_PRICE_ID=
STRIPE_TIER3_PRICE_ID=
STRIPE_TIER1_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER2_EXTRA_LOCATION_PRICE_ID=
STRIPE_TIER3_EXTRA_LOCATION_PRICE_ID=
STRIPE_LITE_BASE_PRICE_ID=     # Stripe price ID for Lite plan ($99/mo recurring, no setup fee)

# Resend
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@superlocalseo.com
RESEND_FROM_NAME=SuperLocalSEO

# BrightLocal (set per client via DB — this is the master account key)
BRIGHTLOCAL_API_KEY=

# EmbedMyReviews
EMBEDMYREVIEWS_API_KEY=
EMBEDMYREVIEWS_WEBHOOK_SECRET=

# PDF Reports
REPORTS_DIR=/app/data/reports

# Monitoring. CONFIGURED 2026-08-17 — self-hosted GlitchTip, not sentry.io.
#
# GlitchTip speaks the Sentry protocol, so @sentry/node works unchanged; only the
# DSN differs. Chosen because it needs no external account or subscription and
# keeps error data on this box. Stack lives in /root/glitchtip.
#
#   UI:  http://localhost:8010  (admin creds in /root/glitchtip/.admin-password)
#   DSN: http://<key>@172.27.0.1:8010/1
#
# NOTE the host IP: from inside the API container, `localhost` is the container
# itself. 172.27.0.1 is the docker gateway, which is how the API reaches the
# host-published GlitchTip port. If the compose network is recreated the gateway
# can change — re-check with:
#   docker inspect superlocalseo-api --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
#
# Verified end to end: a real 500 (malformed uuid -> Postgres 22P02) was captured
# with its full error message.
#
# Caveat: Sentry v8 wants init() before the other imports for full
# auto-instrumentation — the SDK logs "express is not instrumented" on boot.
# Error capture works regardless; performance tracing will be partial until
# init moves into its own module imported first.
SENTRY_DSN=
